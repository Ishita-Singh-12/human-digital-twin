# URL of your own deployed Appwrite function, ending in /get-health-data.
GET_HEALTH_URL=
# Optional overrides. Defaults work with npm run dev from web/health-dashboard.
# HDT_PROJECT_ROOT=/absolute/path/to/human-digital-twin
# HDT_PYTHON=/absolute/path/to/python
# HDT_MODEL_SCRIPT=/absolute/path/to/ml/main.py
# HDT_DATASET_PATH=/absolute/path/to/custom.csv
# Optional richer-signal model settings. Artifact must be locally trusted.
# HDT_STRESS_SCRIPT=/absolute/path/to/ml/stress_model.py
# HDT_STRESS_MODEL_PATH=/absolute/path/to/local/eda_model.joblib
# Public Appwrite platform config, never server API keys:
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
